# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/quilio?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Client URL / Allowed CORS origins (e.g., https://quilio-olive.vercel.app in production)
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=https://quilio-olive.vercel.app

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sign-In (OAuth 2.0 Web Client)
# Same Client ID as frontend VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=123456789012-xxxxxxxx.apps.googleusercontent.com
# Client Secret is NOT required for Google Identity Services (button / ID token).
# Keep it only if you later add server-side OAuth code flow:
GOOGLE_CLIENT_SECRET=optional_for_gis_id_token_flow

RAG_MIN_SCORE=0.35
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMS=768
AI_DAILY_LIMIT=40

USE_ATLAS_VECTOR_SEARCH=false
ATLAS_VECTOR_INDEX=embedding_vector_index

# Gemini models (Oct 2026 defaults — text-embedding-004 & gemini-2.0-flash are shut down)
# https://ai.google.dev/gemini-api/docs/deprecations
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_WRITING_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
