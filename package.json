{
  "name": "quilio",
  "version": "1.0.0",
  "private": true,
  "description": "Quilio monorepo — use client/ and server/ packages",
  "scripts": {
    "test": "npm --prefix server test",
    "test:server": "npm --prefix server test",
    "build": "npm --prefix client run build",
    "eval:rag": "npm --prefix server run eval:rag",
    "eval:rag:live": "npm --prefix server run eval:rag:live",
    "smoke:ai": "npm --prefix server run smoke:ai",
    "embeddings:reindex": "npm --prefix server run embeddings:reindex",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev"
  }
}
