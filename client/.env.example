# Google Sign-In — OAuth 2.0 Web Client ID (NOT the secret)
# Google Cloud Console → Google Auth Platform → Clients → Web application
# Authorized JavaScript origins: http://localhost:5173, https://quilio-olive.vercel.app
VITE_GOOGLE_CLIENT_ID=123456789012-xxxxxxxx.apps.googleusercontent.com

# Backend API URL (optional in production, defaults to https://quilio.onrender.com/api)
# VITE_API_URL=https://quilio.onrender.com/api

# Socket.io Server URL (optional, automatically derived from VITE_API_URL or defaults to https://quilio.onrender.com)
# VITE_SOCKET_URL=https://quilio.onrender.com
